---
import type { CaseStudy } from '../data/cases';
interface Props { project: CaseStudy }
const { project } = Astro.props;
---
<article class="case-card">
  <a class="case-card-image" href={`/beispiele/${project.slug}`} tabindex="-1" aria-hidden="true">
    <img src={project.preview.src} alt="" width={project.preview.width} height={project.preview.height} loading="lazy" decoding="async" />
  </a>
  <div class="case-card-copy">
    <div class="case-meta"><span>{project.industry}</span>{project.isDemo && <span class="case-badge">Demoprojekt</span>}</div>
    {project.logo && <img class="case-logo" src={project.logo.src} alt={project.logo.alt} width={project.logo.width} height={project.logo.height} loading="lazy" decoding="async" />}
    <h3>{project.name}</h3>
    <p>{project.summary}</p>
    <div class="case-actions">
      <a class="text-link" href={`/beispiele/${project.slug}`}>Projekt ansehen <span aria-hidden="true">→</span><span class="sr-only">: {project.name}</span></a>
      {project.websiteUrl && <a class="text-link" href={project.websiteUrl}>{project.isDemo ? 'Live-Demo' : 'Zur Website'} <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
