---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PriceCard from '../components/PriceCard.astro';
import Faq from '../components/Faq.astro';
import HeroShowcase from '../components/HeroShowcase.astro';

const services = [
  { icon: 'layout', title: 'Professioneller Auftritt', text: 'Ein individuelles Design, das zu Ihrem Unternehmen passt und Vertrauen schafft.', featured: true },
  { icon: 'shield', title: 'Technik, die läuft', text: 'Hosting, SSL und technische Wartung sind bereits enthalten.', featured: true },
  { icon: 'phone', title: 'Auf jedem Gerät', text: 'Schnell und zuverlässig – vom Smartphone bis zum großen Bildschirm.' },
  { icon: 'pen', title: 'Texte inklusive', text: 'Sie liefern die wichtigsten Informationen. Ich mache daraus verständliche Website-Texte.' },
  { icon: 'mail', title: 'Einfach anfragen', text: 'Klare Kontaktwege machen es Interessenten leicht, mit Ihnen ins Gespräch zu kommen.' },
  { icon: 'refresh', title: 'Laufend gepflegt', text: 'Kleine Änderungen erledige ich persönlich innerhalb des vereinbarten Kontingents.' },
];
const basic = ['Bis zu 5 Seiten', 'Responsives Design', 'Texterstellung', 'Hosting & SSL', 'Technische Wartung', 'SEO-Grundlagen', 'Kontaktformular', 'Projekt-/Referenzbereich', '15 Minuten Änderungen pro Monat', '2 Korrekturrunden vor Veröffentlichung'];
const pro = ['Alles aus dem Website-Paket', 'Strukturierte Projektanfragen', 'Individuelle Fragen', 'Optionaler Foto-Upload', 'Bessere Projektqualifizierung', 'Erweiterter Projekt-/Referenzbereich', '30 Minuten Änderungen pro Monat'];
---
<BaseLayout title="Gehrke Webservice | Professionelle Websites" description="Moderne Websites für kleine Unternehmen – ohne Erstellungskosten, mit Hosting, Technik und persönlicher Betreuung.">
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <Header />
  <main id="main">
    <section class="hero" id="top">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Webservice für kleine Unternehmen</p>
          <h1>Ihre Website.<br /><span>Ich kümmere mich<br class="hero-break" /> um den Rest.</span></h1>
          <p class="lead">Ich erstelle Ihre Website und kümmere mich anschließend um Hosting, Pflege und Änderungen.</p>
          <div class="button-row"><a class="button" href="#anfrage">Website anfragen <span aria-hidden="true">→</span></a><a class="text-link" href="#ablauf">So funktioniert’s <span aria-hidden="true">→</span></a></div>
          <p class="hero-personal">Direkt mit mir – von der ersten Idee bis zur laufenden Betreuung.</p>
        </div>
        <HeroShowcase />
      </div>
    </section>

    <div class="trust"><div class="container trust-grid"><p><span>✓</span> Persönlicher Ansprechpartner</p><p><span>✓</span> 0 € Erstellung</p><p><span>✓</span> Hosting &amp; Betreuung inklusive</p></div></div>

    <section id="leistungen"><div class="container"><div class="section-heading"><div><p class="eyebrow">Alles aus einer Hand</p><h2>Eine Website, die für<br />Sie arbeitet.</h2></div><p>Von Gestaltung und Texten bis Hosting, Technik und Änderungen – ich kümmere mich um den laufenden Webauftritt.</p></div><div class="service-grid">{services.map(({ icon, title, text, featured }) => <article class:list={['service', { 'service-featured': featured }]}><div class="service-title"><div class="icon"><Icon name={icon} /></div><h3>{title}</h3></div><p>{text}</p></article>)}</div><div class="service-accordion">{services.map(({ icon, title, text }) => <details class="service-item"><summary><span class="service-summary"><span class="icon"><Icon name={icon} /></span><span>{title}</span></span><span class="service-toggle" aria-hidden="true"></span></summary><p>{text}</p></details>)}</div></div></section>

    <section class="process" id="ablauf">
      <div class="container">
        <p class="eyebrow light">So läuft es ab</p>
        <h2>In vier Schritten online.</h2>
        <div class="steps">
          <article><span>01</span><div><h3>Kennenlernen</h3><p>Wir sprechen über Ihren Betrieb, Ihre Leistungen und was Ihre Website erreichen soll.</p></div></article>
          <article><span>02</span><div><h3>Erstellung</h3><p>Ich entwickle Struktur, Design und Texte passend zu Ihrem Unternehmen.</p></div></article>
          <article><span>03</span><div><h3>Freigabe</h3><p>Sie prüfen alles in Ruhe. Ihre Rückmeldungen fließen direkt ein.</p></div></article>
          <article><span>04</span><div><h3>Online &amp; betreut</h3><p>Ihre Website geht online. Hosting, Technik und Änderungen bleiben bei mir.</p></div></article>
        </div>
        <p class="process-claim">Sie kümmern sich um Ihr Unternehmen.<br /><strong>Ich kümmere mich um Ihre Website.</strong></p>
      </div>
    </section>

    <section id="ueber-mich">
      <div class="container about-grid">
        <figure class="portrait">
          <div class="portrait-frame"><img src="/david-portrait.jpg" alt="David, persönlicher Ansprechpartner bei Gehrke Webservice" width="1200" height="1200" loading="lazy" decoding="async" /></div>
        </figure>
        <div class="about-copy">
          <p class="eyebrow">Persönlich betreut</p>
          <h2>Hallo, ich bin David.</h2>
          <div class="about-text">
            <p>Mein Hintergrund liegt in IT-Projektmanagement, digitalen Produkten und der Umsetzung komplexer Digitalvorhaben. Genau deshalb halte ich den Prozess für kleinere Unternehmen bewusst einfach: klare Anforderungen, schnelle Umsetzung und ein fester Ansprechpartner.</p>
            <p>Mit Gehrke Webservice übertrage ich diesen Ansatz auf professionelle Websites – von Struktur und Gestaltung bis Technik, Hosting und laufenden Änderungen.</p>
          </div>
          <ul class="competence-points" aria-label="Erfahrung und Arbeitsweise">
            <li>Erfahrung in digitalen Projekten</li>
            <li>Strukturierte, klare Umsetzung</li>
            <li>Direkte Betreuung ohne Agentur-Umwege</li>
          </ul>
          <div class="signature"><strong>David Gehrke</strong><span>Gründer von Gehrke Webservice</span></div>
        </div>
      </div>
    </section>

    <section class="pricing" id="preise"><div class="container"><div class="center-heading"><p class="eyebrow">Klare Preise</p><h2>Einfach planen.<br />Professionell auftreten.</h2><p>Keine hohe Anfangsinvestition. Alles Wichtige ist bereits enthalten.</p></div><div class="price-grid"><PriceCard title="Website" price="79" features={basic} /><PriceCard title="Website Pro" price="109" features={pro} featured /></div><p class="price-note">Alle Preise netto zzgl. gesetzlicher Umsatzsteuer.<br />12 Monate Mindestlaufzeit, danach monatlich kündbar.</p></div></section>

    <section class="monthly"><div class="container monthly-grid"><div><p class="eyebrow">Warum monatlich?</p><h2>Ihre Website ist kein einmaliges Projekt.</h2></div><div><p>Eine gute Website soll dauerhaft schnell, sicher und aktuell bleiben. Deshalb endet meine Arbeit nicht mit der Veröffentlichung.</p><ul><li><span>01</span> Keine hohe Einmalinvestition</li><li><span>02</span> Hosting & Technik inklusive</li><li><span>03</span> Laufende persönliche Betreuung</li><li><span>04</span> Feste, planbare Kosten</li></ul></div></div></section>

    <section id="faq"><div class="container faq-grid"><div><p class="eyebrow">Häufige Fragen</p><h2>Gut zu wissen.</h2><p>Noch etwas unklar? Schreiben Sie mir einfach – ich antworte persönlich.</p><a class="text-link" href="mailto:david@gehrke-webservice.de">david@gehrke-webservice.de →</a></div><Faq /></div></section>

    <section class="final-cta" id="anfrage"><div class="container"><p class="eyebrow light">Bereit für den nächsten Schritt?</p><h2>Ihre neue Website kann<br /><em>unkompliziert sein.</em></h2><p>Erzählen Sie mir kurz von Ihrem Unternehmen. Ich melde mich persönlich und wir schauen gemeinsam, ob es passt.</p><a class="button button-light" href="mailto:david@gehrke-webservice.de">Unverbindlich anfragen <span>→</span></a><a class="email" href="mailto:david@gehrke-webservice.de">david@gehrke-webservice.de</a></div></section>
  </main>
  <footer><div class="container footer-top"><div><a class="brand" href="#top"><span>Gehrke</span> Webservice</a><p>Professionelle Websites.<br />Einfach geregelt.</p></div><div><p class="footer-label">Navigation</p><a href="#leistungen">Leistungen</a><a href="#ablauf">Ablauf</a><a href="#preise">Preise</a><a href="#ueber-mich">Über mich</a></div><div><p class="footer-label">Kontakt</p><a href="mailto:david@gehrke-webservice.de">david@gehrke-webservice.de</a></div><div><p class="footer-label">Rechtliches</p><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Gehrke Webservice</span><span>Persönlich. Verlässlich. Auf Augenhöhe.</span></div></footer>
</BaseLayout>
