---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import PriceCard from '../components/PriceCard.astro';
import Faq from '../components/Faq.astro';

const services = [
  ['layout', 'Professioneller Auftritt', 'Ein klares, individuelles Design, das zu Ihrem Betrieb passt und Vertrauen schafft.'],
  ['phone', 'Auf jedem Gerät', 'Ihre Website funktioniert schnell und zuverlässig – vom Smartphone bis zum großen Bildschirm.'],
  ['pen', 'Texte inklusive', 'Sie müssen kein Texter sein. Gemeinsam bringen wir Ihr Angebot verständlich auf den Punkt.'],
  ['shield', 'Technik, die läuft', 'Hosting, SSL und technische Wartung sind bereits enthalten. Sie müssen sich um nichts kümmern.'],
  ['mail', 'Einfach erreichbar', 'Klare Kontaktwege machen es Interessenten leicht, eine passende Anfrage zu stellen.'],
  ['refresh', 'Bleibt aktuell', 'Kleine Änderungen erledige ich persönlich und unkompliziert im monatlichen Rahmen.'],
];
const basic = ['Bis zu 5 Seiten', 'Responsives Design', 'Texterstellung', 'Hosting & SSL', 'Technische Wartung', 'SEO-Grundlagen', 'Kontaktformular', 'Projekt-/Referenzbereich', '15 Minuten Änderungen pro Monat', '2 Korrekturrunden vor Veröffentlichung'];
const pro = ['Alles aus dem Website-Paket', 'Strukturierte Projektanfragen', 'Individuelle Fragen', 'Optionaler Foto-Upload', 'Bessere Projektqualifizierung', 'Erweiterter Projekt-/Referenzbereich', '30 Minuten Änderungen pro Monat'];
---
<BaseLayout title="[Nachname] Webservice | Professionelle Websites" description="Moderne Websites für kleine Unternehmen – ohne Erstellungskosten, mit Hosting, Technik und persönlicher Betreuung.">
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <Header />
  <main id="main">
    <section class="hero" id="top">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Webservice für kleine Unternehmen</p>
          <h1>Professionelle Websites.<br /><em>Einfach geregelt.</em></h1>
          <p class="lead">Ich erstelle moderne Websites für kleine Unternehmen und kümmere mich anschließend um Hosting, Technik und Änderungen.</p>
          <p class="hero-price"><strong>0 € Erstellung</strong><span>·</span> ab 79 € / Monat</p>
          <div class="button-row"><a class="button" href="#anfrage">Website anfragen <span>→</span></a><a class="text-link" href="#ablauf">So funktioniert’s <span>↓</span></a></div>
        </div>
        <div class="mockup-wrap" aria-label="Platzhalter für ein späteres Website-Mockup" role="img">
          <div class="mockup-accent"></div><div class="browser"><div class="browser-bar"><i></i><i></i><i></i><span></span></div><div class="demo-nav"><b>LOGO</b><div></div></div><div class="demo-body"><div><small>IHR HANDWERK. UNSERE LEIDENSCHAFT.</small><h2>Qualität, auf die<br />Sie bauen können.</h2><p></p><button tabindex="-1">Projekt anfragen</button></div><div class="demo-shape"><span>Website-<br />Mockup</span></div></div></div>
          <span class="mockup-label">Platzhalter · Ihre Website</span>
        </div>
      </div>
    </section>

    <div class="trust"><div class="container trust-grid"><p><span>✓</span> Persönlicher Ansprechpartner</p><p><span>✓</span> Keine Erstellungskosten</p><p><span>✓</span> Hosting & Betreuung inklusive</p></div></div>

    <section id="leistungen"><div class="container"><div class="section-heading"><div><p class="eyebrow">Alles aus einer Hand</p><h2>Eine Website, die für<br />Sie arbeitet.</h2></div><p>Professionell im Auftritt, einfach in der Zusammenarbeit. Ich kümmere mich um alles, was Ihre Website braucht.</p></div><div class="service-grid">{services.map(([icon, title, text]) => <article class="service"><div class="icon"><Icon name={icon} /></div><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

    <section class="process" id="ablauf"><div class="container"><p class="eyebrow light">So läuft es ab</p><h2>In vier Schritten online.</h2><div class="steps"><article><span>01</span><div><h3>Kennenlernen</h3><p>Wir sprechen über Ihren Betrieb, Ihre Ziele und was Ihre Website leisten soll.</p></div></article><article><span>02</span><div><h3>Erstellung</h3><p>Ich entwickle Design, Struktur und Texte – passend zu Ihrem Unternehmen.</p></div></article><article><span>03</span><div><h3>Freigabe</h3><p>Sie prüfen alles in Ruhe. Ihre Rückmeldungen fließen direkt in die Website ein.</p></div></article><article><span>04</span><div><h3>Online & betreut</h3><p>Ihre Website geht online. Technik und Änderungen bleiben bei mir in guten Händen.</p></div></article></div><blockquote>„Sie kümmern sich um Ihr Unternehmen.<br /><strong>Ich kümmere mich um Ihre Website.</strong>“</blockquote></div></section>

    <section id="ueber-mich"><div class="container about-grid"><div class="portrait" role="img" aria-label="Platzhalter für ein Portraitfoto von David"><div class="portrait-mark">D</div><span>Portraitfoto<br />David</span></div><div class="about-copy"><p class="eyebrow">Persönlich für Sie da</p><h2>Hallo, ich bin David.</h2><p class="lead-small">Bei mir sprechen Sie nicht mit einem Ticketsystem, sondern direkt mit dem Menschen, der Ihre Website erstellt und betreut.</p><p>Ich unterstütze kleine Unternehmen dabei, professionell im Internet aufzutreten – ohne unnötige Fachbegriffe oder komplizierte Prozesse. Von unserem ersten Gespräch bis zu späteren Änderungen haben Sie einen festen Ansprechpartner.</p><div class="signature">David <span>Persönlicher Ansprechpartner</span></div></div></div></section>

    <section class="pricing" id="preise"><div class="container"><div class="center-heading"><p class="eyebrow">Klare Preise</p><h2>Einfach planen.<br />Professionell auftreten.</h2><p>Keine hohe Anfangsinvestition. Alles Wichtige ist bereits enthalten.</p></div><div class="price-grid"><PriceCard title="Website" price="79" features={basic} /><PriceCard title="Website Pro" price="109" features={pro} featured /></div><p class="price-note">Alle Preise netto zzgl. gesetzlicher Umsatzsteuer.<br />12 Monate Mindestlaufzeit, danach monatlich kündbar.</p></div></section>

    <section class="monthly"><div class="container monthly-grid"><div><p class="eyebrow">Warum monatlich?</p><h2>Ihre Website ist kein einmaliges Projekt.</h2></div><div><p>Eine gute Website soll dauerhaft schnell, sicher und aktuell bleiben. Deshalb endet meine Arbeit nicht mit der Veröffentlichung.</p><ul><li><span>01</span> Keine hohe Einmalinvestition</li><li><span>02</span> Hosting & Technik inklusive</li><li><span>03</span> Laufende persönliche Betreuung</li><li><span>04</span> Feste, planbare Kosten</li></ul></div></div></section>

    <section id="faq"><div class="container faq-grid"><div><p class="eyebrow">Häufige Fragen</p><h2>Gut zu wissen.</h2><p>Noch etwas unklar? Schreiben Sie mir einfach – ich antworte persönlich.</p><a class="text-link" href="mailto:david@[domain].de">david@[domain].de →</a></div><Faq /></div></section>

    <section class="final-cta" id="anfrage"><div class="container"><p class="eyebrow light">Bereit für den nächsten Schritt?</p><h2>Ihre neue Website kann<br /><em>unkompliziert sein.</em></h2><p>Erzählen Sie mir kurz von Ihrem Unternehmen. Ich melde mich persönlich und wir schauen gemeinsam, ob es passt.</p><a class="button button-light" href="mailto:david@[domain].de">Unverbindlich anfragen <span>→</span></a><a class="email" href="mailto:david@[domain].de">david@[domain].de</a></div></section>
  </main>
  <footer><div class="container footer-top"><div><a class="brand" href="#top"><span>[Nachname]</span> Webservice</a><p>Professionelle Websites.<br />Einfach geregelt.</p></div><div><p class="footer-label">Navigation</p><a href="#leistungen">Leistungen</a><a href="#ablauf">Ablauf</a><a href="#preise">Preise</a><a href="#ueber-mich">Über mich</a></div><div><p class="footer-label">Kontakt</p><a href="mailto:david@[domain].de">david@[domain].de</a></div><div><p class="footer-label">Rechtliches</p><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} [Nachname] Webservice</span><span>Persönlich. Verlässlich. Auf Augenhöhe.</span></div></footer>
</BaseLayout>
