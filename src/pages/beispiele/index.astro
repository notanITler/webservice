---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases } from '../../data/cases';
import '../../styles/cases.css';
---
<BaseLayout title="Beispiele | Gehrke Webservice" description="Beispiele für Websites, die Gestaltung, Struktur und Kontaktwege auf unterschiedliche Unternehmen abstimmen." canonicalPath="/beispiele/">
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <Header />
  <main id="main" class="portfolio-page">
    <section class="portfolio-hero">
      <div class="container">
        <p class="eyebrow">Beispiele</p>
        <h1>Websites, die zum Unternehmen passen.</h1>
        <p class="lead">Jeder Betrieb hat andere Leistungen, Kunden und Ziele. Die Beispiele zeigen unterschiedliche Ansätze für Struktur, Gestaltung und Kontaktwege.</p>
      </div>
    </section>
    <section class="portfolio-overview" aria-label="Alle Beispiele">
      <div class="container">
        <div class="case-grid case-grid-overview">{cases.map((project) => <CaseCard project={project} />)}</div>
      </div>
    </section>
  </main>
  <footer><div class="container case-footer"><a class="brand" href="/"><span>Gehrke</span> Webservice</a><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div></footer>
</BaseLayout>
